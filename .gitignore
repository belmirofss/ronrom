# dependências
node_modules/

# saída de build
dist/
.vercel/

# tipos gerados pelo Astro
.astro/

# runtime temporário do Sanity Studio (recriado a cada `sanity dev`)
.sanity/

# schema extraído pelo `pnpm typegen` (os tipos gerados a partir dele são versionados)
studio/schema.json

# variáveis de ambiente (só o exemplo é versionado)
.env*
!.env.example
!studio/.env.production

# logs
npm-debug.log*
pnpm-debug.log*

# sistema e editores
.DS_Store
.idea/

# configuração local do Claude Code (worktrees e servidores de preview)
.claude/

# relatórios do Lighthouse CI rodado localmente (docs/performance.md)
.lighthouseci/
