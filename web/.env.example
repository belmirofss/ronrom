# Variáveis do site (web/). Copie para web/.env e preencha só o que precisar, ou puxe as da
# Vercel com `vercel env pull .env.local` dentro de web/ (veja docs/ambientes.md).
# Os .env não são versionados. Nenhum valor real entra neste arquivo.
# O schema que valida tudo fica em web/astro.config.mjs (env.schema).
# Uma variável vazia conta como ausente. Sem nenhuma delas, o build roda com as fixtures.

# --- Site ---

# URL base absoluta, sem barra no final. Obrigatória em produção.
# Fora dela, o padrão é a URL do deploy nos previews da Vercel e https://ronrom.blog
# no resto (local e CI).
SITE_URL=

# Endereço do Studio, usado no link "Área da autora" do rodapé. Padrão: https://ronrom.sanity.studio.
STUDIO_URL=

# --- Sanity (públicas: não são segredo) ---

# ID do projeto "Ronrom" em https://www.sanity.io/manage. Obrigatória em produção.
SANITY_PROJECT_ID=

# Dataset lido pelo site: development ou production. Obrigatória em produção.
# Sem SANITY_PROJECT_ID e SANITY_DATASET, o build usa as fixtures locais (#33).
SANITY_DATASET=

# Versão da API do Sanity (data AAAA-MM-DD). Padrão: 2025-02-19.
SANITY_API_VERSION=

# true força as fixtures mesmo com o Sanity configurado. Padrão: false. Proibido em produção.
SANITY_FIXTURES=

# --- Prévia de rascunhos (#43, docs/ambientes.md#prévia-de-rascunhos-ronrom-previa) ---

# true liga o modo prévia: tudo sob demanda, rascunhos com o token viewer e edição visual.
# Só no projeto ronrom-previa da Vercel, ou localmente para testar com o Studio local.
# Padrão: false. Com true, também exige SANITY_API_READ_TOKEN e SITE_URL fora do site.
PUBLIC_SANITY_VISUAL_EDITING_ENABLED=

# --- Analytics ---

# Website-id do site no Umami Cloud (#58), um UUID. Opcional: o script só entra no build de
# produção (VERCEL_ENV=production), então localmente não faz diferença (docs/analytics.md).
PUBLIC_UMAMI_ID=

# --- Segredos (só no servidor; nunca chegam ao navegador) ---

# Token "viewer" do Sanity, só para a prévia de rascunhos (#43). Obrigatório com a prévia ligada.
SANITY_API_READ_TOKEN=

# Upstash Redis do contador de visualizações (#56), injetado pela integração do Marketplace
# da Vercel. Opcional: sem as duas, a /api/views não grava nada. Fora de produção ela também não
# grava, então só preencha para testar o cliente do Redis (docs/visualizacoes.md).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Sistema da Vercel (não preencha) ---

# VERCEL_ENV: production, preview ou development, injetada pela Vercel. Só em production a
# /api/views conta visualizações e o site é indexável (#52). Fora da Vercel fica ausente: nada
# é contado, o robots.txt bloqueia tudo e as páginas saem com noindex,nofollow.

# VERCEL_GIT_COMMIT_SHA: o commit do deploy, injetado pela Vercel e devolvido pelo /api/health.
# Fora da Vercel fica ausente e a rota responde "commit": null.
