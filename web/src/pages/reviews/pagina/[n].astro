---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Listagem from '@/components/listagem/Listagem.astro';
import { paginasExtras, TEXTOS_DAS_SECOES } from '@/lib/listagem';
import { naoEncontrada, numeroDaPagina } from '@/lib/previa';
import { buscarPostsDoTipo, totalDePaginas } from '@/lib/sanity/conteudo';
import { trilhaDoTipo } from '@/lib/trilha';

// Da página 2 em diante: a 1 é a própria /reviews (docs/seo-urls.md#paginação).
export const getStaticPaths = (async () => {
  const { total } = await buscarPostsDoTipo('review');
  return paginasExtras(totalDePaginas(total)).map((pagina) => ({
    params: { n: String(pagina) },
    props: { pagina },
  }));
}) satisfies GetStaticPaths;

type Props = Partial<InferGetStaticPropsType<typeof getStaticPaths>>;

const pagina = numeroDaPagina(Astro.props.pagina, Astro.params.n);
if (!pagina) return naoEncontrada(Astro, `Página "${Astro.params.n}" inválida.`);
const { posts, total } = await buscarPostsDoTipo('review', pagina);
if (pagina > totalDePaginas(total)) {
  return naoEncontrada(Astro, `Página ${pagina} além da última (${totalDePaginas(total)}).`);
}
---

<Listagem
  {...TEXTOS_DAS_SECOES.review}
  trilha={trilhaDoTipo('review')}
  base="/reviews"
  pagina={pagina}
  posts={posts}
  total={total}
/>
