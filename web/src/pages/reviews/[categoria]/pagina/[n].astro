---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Listagem from '@/components/listagem/Listagem.astro';
import { paginasExtras, textosDaCategoria } from '@/lib/listagem';
import { naoEncontrada, numeroDaPagina } from '@/lib/previa';
import { urlDaCategoria } from '@/lib/rotas';
import { buscarPostsDaCategoria, buscarTaxonomia, totalDePaginas } from '@/lib/sanity/conteudo';
import { trilhaDaCategoria } from '@/lib/trilha';

// Da página 2 em diante de cada categoria, pelas contagens da taxonomia: a 1 é a própria listagem.
export const getStaticPaths = (async () => {
  const taxonomia = await buscarTaxonomia();
  return (taxonomia?.categorias ?? []).flatMap(({ slug, total }) =>
    paginasExtras(totalDePaginas(total)).map((pagina) => ({
      params: { categoria: slug, n: String(pagina) },
      props: { pagina },
    })),
  );
}) satisfies GetStaticPaths;

type Props = Partial<InferGetStaticPropsType<typeof getStaticPaths>>;

const { categoria: slug } = Astro.params;
const pagina = numeroDaPagina(Astro.props.pagina, Astro.params.n);
if (!pagina) return naoEncontrada(Astro, `Página "${Astro.params.n}" inválida.`);
const { categoria, posts, total } = await buscarPostsDaCategoria(slug, pagina);
if (!categoria) return naoEncontrada(Astro, `Categoria "${slug}" não encontrada na listagem.`);
if (pagina > totalDePaginas(total)) {
  return naoEncontrada(Astro, `Página ${pagina} além da última (${totalDePaginas(total)}).`);
}
---

<Listagem
  {...textosDaCategoria(categoria)}
  trilha={trilhaDaCategoria(categoria)}
  base={urlDaCategoria(slug)}
  pagina={pagina}
  posts={posts}
  total={total}
/>
