---
import Listagem from '@/components/listagem/Listagem.astro';
import { TEXTOS_DAS_SECOES } from '@/lib/listagem';
import { buscarUltimos } from '@/lib/sanity/conteudo';
import { trilhaDeTodosOsPosts } from '@/lib/trilha';

const { posts, total } = await buscarUltimos();
---

<Listagem
  {...TEXTOS_DAS_SECOES.posts}
  trilha={trilhaDeTodosOsPosts()}
  base="/posts"
  pagina={1}
  posts={posts}
  total={total}
/>
