---
import type { GetStaticPaths } from 'astro';
import Listagem from '@/components/listagem/Listagem.astro';
import { textosDoFormato } from '@/lib/listagem';
import { naoEncontrada } from '@/lib/previa';
import { urlDoFormato } from '@/lib/rotas';
import { buscarPostsDoFormato, buscarTaxonomia } from '@/lib/sanity/conteudo';
import { trilhaDoFormato } from '@/lib/trilha';

// Todo formato publicado, com post ou não: a barra lateral lista todos, e o sem post mostra o
// estado vazio.
export const getStaticPaths = (async () => {
  const taxonomia = await buscarTaxonomia();
  return (taxonomia?.formatos ?? []).map(({ slug }) => ({ params: { formato: slug } }));
}) satisfies GetStaticPaths;

const { formato: slug } = Astro.params;
const { formato, posts, total } = await buscarPostsDoFormato(slug);
if (!formato) return naoEncontrada(Astro, `Formato "${slug}" não encontrado na listagem.`);
---

<Listagem
  {...textosDoFormato(formato)}
  trilha={trilhaDoFormato(formato)}
  base={urlDoFormato(slug)}
  pagina={1}
  posts={posts}
  total={total}
/>
