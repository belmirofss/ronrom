---
import BarraLateral from '@/components/barra-lateral/BarraLateral.astro';
import MaisLidos from '@/components/home/MaisLidos.astro';
import CampoDeBusca from '@/components/busca/CampoDeBusca.astro';
import TopoHome from '@/components/home/TopoHome.astro';
import Destaque from '@/components/post/Destaque.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import ListaDePosts from '@/components/post/ListaDePosts.astro';
import Abas from '@/components/ui/Abas.astro';
import EstadoVazio from '@/components/ui/EstadoVazio.astro';
import LayoutComBarraLateral from '@/layouts/LayoutComBarraLateral.astro';
import { EVENTOS } from '@/lib/analytics';
import { ultimosSemODestaque } from '@/lib/home';
import {
  buscarConfiguracoes,
  buscarDestaque,
  buscarSobre,
  buscarUltimos,
} from '@/lib/sanity/conteudo';
import { DESCRICAO_DO_SITE } from '@/lib/utils/site';

const [configuracoes, sobre, destaque, { posts }] = await Promise.all([
  buscarConfiguracoes(),
  buscarSobre(),
  buscarDestaque(),
  buscarUltimos(),
]);

// Description e imagem de compartilhamento da home: as de Configurações do site, se preenchidas.
const seo = configuracoes?.seo;

// O destaque é o escolhido em Configurações ou, na falta, o mais recente; a aba não o repete.
const ultimos = ultimosSemODestaque(posts, destaque);

const ABAS = [
  { id: 'ultimos', titulo: 'Últimos posts' },
  { id: 'mais-lidos', titulo: 'Mais lidos' },
];
---

<LayoutComBarraLateral
  seo={{
    description: seo?.descricao || DESCRICAO_DO_SITE,
    canonical: '/',
    image: seo?.imagem,
  }}
>
  <JsonLd slot="head" pagina={{ tipo: 'home' }} />

  {/* O único h1 da home, "Ronrom", está no TopoHome, assinado com o nome do Sobre. */}
  <TopoHome slot="topo" autora={sobre?.nome?.trim()} />

  {destaque ? (
    <div class="home">
      <Destaque post={destaque} />

      <Abas abas={ABAS} rotulo="Posts" evento={EVENTOS.trocaDeAba}>
        {/* Leva a /busca?q=termo, com ou sem JS (#55). */}
        <CampoDeBusca slot="ao-lado" id="busca-home" />
        <Fragment slot="ultimos">
          {ultimos.length > 0 ? (
            <ListaDePosts posts={ultimos} nivelTitulo={3} />
          ) : (
            <EstadoVazio mensagem="Por enquanto, o único post é o do destaque." />
          )}
        </Fragment>
        <MaisLidos slot="mais-lidos" />
      </Abas>

      <a class="home__ver-todos" href="/posts">
        Ver todos os posts
      </a>
    </div>
  ) : (
    <EstadoVazio
      mensagem="Ainda não tem nenhum post publicado. Volte daqui a pouquinho!"
      link={{ rotulo: 'Enquanto isso, conheça a autora', href: '/sobre' }}
    />
  )}

  <BarraLateral slot="barra-lateral" />
</LayoutComBarraLateral>

<style>
  .home {
    display: grid;
    gap: var(--espaco-8);
  }

  /* No celular, o campo ocupa a linha toda embaixo das abas; a partir de 640px, fica ao lado. */
  .home :global(.abas__ao-lado) {
    flex: 1 1 100%;
  }

  @media (min-width: 40rem) {
    .home :global(.abas__ao-lado) {
      flex: 0 1 20rem;
    }
  }

  /* Botão secundário: contorno e texto vinho (9,70:1), com o fundo creme no hover. */
  .home__ver-todos {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    min-height: 44px;
    padding: var(--espaco-3) var(--espaco-5);
    border: 2px solid var(--cor-vinho);
    border-radius: var(--raio-pilula);
    font-weight: var(--peso-medio);
    line-height: var(--altura-linha-titulo);
    text-decoration-line: none;
  }

  .home__ver-todos:hover {
    background-color: var(--cor-creme);
    color: var(--cor-vinho-hover);
  }
</style>
