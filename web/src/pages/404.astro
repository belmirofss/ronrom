---
import Gato from '@/assets/formas/gato.svg';
import Container from '@/components/layout/Container.astro';
import CardDePost from '@/components/post/CardDePost.astro';
import LayoutBase from '@/layouts/LayoutBase.astro';
import { SECOES } from '@/lib/navegacao';
import { buscarUltimos } from '@/lib/sanity/conteudo';

// Página estática (sem `prerender = false`): o build gera o 404.html e a Vercel o serve da CDN,
// com status 404, para qualquer URL inexistente (docs/ambientes.md#página-404).

const POSTS_RECENTES = 3;

const recentes = (await buscarUltimos()).posts.slice(0, POSTS_RECENTES);

// Início, Reviews e Pensamentos: a navegação principal sem o Sobre.
const caminhos = SECOES.filter(({ href }) => href !== '/sobre');
---

<LayoutBase
  seo={{
    title: 'Página não encontrada',
    description: 'Esta página não existe ou mudou de endereço.',
    canonical: '/404',
    noindex: true,
  }}
>
  <Container class="nao-encontrada">
    <div class="nao-encontrada__topo">
      {/* A cena, só decorativa: o "0" do 404 é o gato do mosaico, que empurra a página da mesa. */}
      <div class="cena" aria-hidden="true">
        <div class="cena__numero">
          <span>4</span>
          <span class="cena__gato">
            <Gato />
          </span>
          <span>4</span>
        </div>
        <div class="cena__mesa">
          <span class="cena__folha">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </div>
      </div>
      <h1 class="nao-encontrada__titulo">O gato derrubou esta página</h1>
      <p class="nao-encontrada__texto">
        Ela não existe mais, mudou de endereço ou foi parar embaixo do sofá. Enquanto isso, tente um
        destes cantos:
      </p>
      <nav aria-label="Seções do site">
        <ul class="nao-encontrada__caminhos">
          {caminhos.map(({ rotulo, href }) => (
            <li>
              <a href={href}>{rotulo}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    {recentes.length > 0 && (
      <section class="nao-encontrada__recentes" aria-labelledby="nao-encontrada-recentes">
        <h2 id="nao-encontrada-recentes" class="nao-encontrada__subtitulo">
          Ou leia algo recente
        </h2>
        <ul class="nao-encontrada__cards">
          {recentes.map((post) => (
            <li>
              <CardDePost post={post} />
            </li>
          ))}
        </ul>
      </section>
    )}
  </Container>
</LayoutBase>

<style>
  :global(.nao-encontrada) {
    display: flex;
    flex-direction: column;
    gap: var(--espaco-8);
    padding-block: var(--espaco-8);
  }

  .nao-encontrada__topo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--espaco-4);
    text-align: center;
  }

  /* O número em vinho, com o gato no lugar do "0" (rosa sobre vinho, como no mosaico). A mesa é
     uma linha embaixo dele; a folha fica no chão, caída. A animação (só com movimento liberado)
     conta como ela chegou lá: o gato dá um tapinha e a folha escorrega da beirada. */
  .cena {
    --tamanho: clamp(5rem, 22vw, 10rem);

    display: grid;
    justify-items: center;
    margin-block-end: var(--espaco-4);
    /* Na largura toda: no meio da queda, a folha passa da mesa, e no celular a página rolaria de
       lado sem o clip. */
    align-self: stretch;
    overflow-x: clip;
  }

  .cena__numero {
    display: flex;
    align-items: center;
    gap: 0.06em;
    color: var(--cor-vinho);
    font-size: var(--tamanho);
    font-weight: var(--peso-negrito);
    letter-spacing: var(--espacamento-ronrom);
    line-height: 1;
  }

  .cena__gato {
    display: grid;
    place-items: center;
    width: 0.78em;
    aspect-ratio: 1;
    border-radius: 0.12em;
    background-color: var(--cor-vinho);
    color: var(--cor-rosa);
    transform-origin: 50% 100%;
  }

  .cena__gato :global(svg) {
    width: 62%;
  }

  /* A mesa: uma tábua creme do tamanho do número, com espaço embaixo para a folha cair. */
  .cena__mesa {
    position: relative;
    width: calc(var(--tamanho) * 2.4);
    height: calc(var(--tamanho) * 0.7);
    border-block-start: 6px solid var(--cor-rosa);
    border-block-end: 2px solid var(--cor-borda);
  }

  /* As pernas da mesa, um pouco para dentro das pontas; a borda de baixo é o chão. */
  .cena__mesa::before,
  .cena__mesa::after {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 8%;
    width: 6px;
    background-color: var(--cor-rosa);
  }

  .cena__mesa::after {
    inset-inline: auto 30%;
  }

  .cena__folha {
    position: absolute;
    inset-block-end: 0;
    /* Deitada no chão, encostada no fim da mesa: gira 90° em torno do canto de baixo à direita,
       então a borda direita fica uma altura de folha antes do fim. */
    inset-inline-end: calc(var(--tamanho) * 0.56);
    display: grid;
    align-content: center;
    gap: calc(var(--tamanho) * 0.05);
    width: calc(var(--tamanho) * 0.42);
    aspect-ratio: 3 / 4;
    padding-inline: calc(var(--tamanho) * 0.06);
    border: 1px solid var(--cor-borda);
    border-radius: var(--raio-sm);
    background-color: var(--cor-superficie);
    box-shadow: var(--sombra-md);
    transform: rotate(88deg);
    transform-origin: 100% 100%;
  }

  .cena__folha span {
    height: 3px;
    border-radius: 2px;
    background-color: var(--cor-borda);
  }

  .cena__folha span:last-child {
    width: 60%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cena__gato {
      animation: tapinha 1.4s ease-in-out 0.3s backwards;
    }

    .cena__folha {
      animation: cair 1.1s cubic-bezier(0.5, 0, 0.6, 1) 0.75s backwards;
    }
  }

  /* O gato se inclina para a direita (o tapinha), balança e volta reto. */
  @keyframes tapinha {
    30% {
      transform: rotate(12deg) translateX(6%);
    }

    55% {
      transform: rotate(-6deg);
    }

    75% {
      transform: rotate(2deg);
    }
  }

  @keyframes cair {
    0% {
      transform: translate(calc(var(--tamanho) * -0.3), calc(-1 * var(--tamanho) * 0.7 - 6px));
    }

    35% {
      transform: translate(calc(var(--tamanho) * 0.5), calc(-1 * var(--tamanho) * 0.7 - 6px))
        rotate(20deg);
    }

    80% {
      transform: translate(calc(var(--tamanho) * 0.1), 0) rotate(96deg);
    }

    100% {
      transform: rotate(88deg);
    }
  }

  .nao-encontrada__titulo {
    font-size: var(--texto-4xl);
  }

  .nao-encontrada__texto {
    max-width: 40ch;
    color: var(--cor-texto-2);
    font-size: var(--texto-lg);
  }

  .nao-encontrada__caminhos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--espaco-2);
    padding: 0;
    list-style: none;
  }

  /* Pílulas com alvo de toque de 44px de altura. */
  .nao-encontrada__caminhos a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--espaco-5);
    border: 1px solid var(--cor-borda);
    border-radius: var(--raio-pilula);
    font-weight: var(--peso-medio);
    text-decoration-line: none;
  }

  .nao-encontrada__caminhos a:hover {
    border-color: var(--cor-vinho);
    background-color: var(--cor-creme);
  }

  .nao-encontrada__recentes {
    display: flex;
    flex-direction: column;
    gap: var(--espaco-5);
  }

  .nao-encontrada__subtitulo {
    font-size: var(--texto-2xl);
  }

  .nao-encontrada__cards {
    display: grid;
    gap: var(--espaco-6);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .nao-encontrada__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 60em) {
    .nao-encontrada__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
