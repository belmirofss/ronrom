---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Listagem from '@/components/listagem/Listagem.astro';
import { paginasExtras, textosDaTag } from '@/lib/listagem';
import { naoEncontrada, numeroDaPagina } from '@/lib/previa';
import { urlDaTag } from '@/lib/rotas';
import { buscarPostsDaTag, buscarTaxonomia, totalDePaginas } from '@/lib/sanity/conteudo';
import { trilhaDaTag } from '@/lib/trilha';

// Da página 2 em diante de cada tag, pelas contagens da taxonomia: a 1 é a própria listagem.
export const getStaticPaths = (async () => {
  const taxonomia = await buscarTaxonomia();
  return (taxonomia?.tags ?? []).flatMap(({ slug, total }) =>
    paginasExtras(totalDePaginas(total)).map((pagina) => ({
      params: { tag: slug, n: String(pagina) },
      props: { pagina },
    })),
  );
}) satisfies GetStaticPaths;

type Props = Partial<InferGetStaticPropsType<typeof getStaticPaths>>;

const { tag: slug } = Astro.params;
const pagina = numeroDaPagina(Astro.props.pagina, Astro.params.n);
if (!pagina) return naoEncontrada(Astro, `Página "${Astro.params.n}" inválida.`);
const { tag, posts, total } = await buscarPostsDaTag(slug, pagina);
if (!tag) return naoEncontrada(Astro, `Tag "${slug}" não encontrada na listagem.`);
if (pagina > totalDePaginas(total)) {
  return naoEncontrada(Astro, `Página ${pagina} além da última (${totalDePaginas(total)}).`);
}
---

<Listagem
  {...textosDaTag(tag)}
  trilha={trilhaDaTag(tag)}
  base={urlDaTag(slug)}
  pagina={pagina}
  posts={posts}
  total={total}
/>
