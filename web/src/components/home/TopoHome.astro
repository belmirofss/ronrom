---
import Mosaico from '@/components/home/Mosaico.astro';
import { NOME_DO_SITE } from '@/lib/utils/site';

interface Props {
  /** Frase embaixo do nome. */
  subtitulo?: string;
  /** O `nome` do Sobre, na assinatura "Por ..." embaixo do nome. Sem ele, sem assinatura. */
  autora?: string | undefined;
}

const {
  subtitulo = 'Reviews de filmes, séries, documentários, livros, restaurantes e lugares, e pensamentos sobre o resto.',
  autora,
} = Astro.props;
---

{/* A capa ocupa a primeira dobra toda (#141); a seta leva ao que vem depois dela, o
    #depois-do-topo do LayoutComBarraLateral. */}
<div class="topo-home">
  {/* Antes da capa e bloqueante: decide, antes da primeira pintura, se a abertura roda. */}
  <script is:inline src="/abertura-da-home.js"></script>
  <div class="topo-home__capa">
    <div class="topo-home__textos">
      <h1 class="topo-home__nome">{NOME_DO_SITE}</h1>
      {autora && <p class="topo-home__autora">Por {autora}</p>}
      <p class="topo-home__subtitulo">{subtitulo}</p>
    </div>
    <Mosaico />
  </div>
  <a class="topo-home__rolar" href="#depois-do-topo">
    <span class="visualmente-oculto">Ir para os posts</span>
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </a>
</div>

<style>
  /* Altura da tela menos a do cabeçalho (--altura-cabecalho, no Cabecalho), com a capa centrada
     e a seta no pé. Em tela baixa demais a capa só cresce: nada é cortado. */
  .topo-home {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: var(--espaco-4);
    min-block-size: calc(100svh - var(--altura-cabecalho));
    padding-block: var(--espaco-5) var(--espaco-2);
  }

  /* Em tela em pé (celular e tablet), tudo centrado, com o mosaico embaixo do nome; deitada e a
     partir de 640px, o mosaico vai à direita. */
  .topo-home__capa {
    display: grid;
    align-self: center;
    justify-items: center;
    gap: var(--espaco-6);
    text-align: center;
  }

  /* O mosaico diminui em tela baixa, para a capa caber na primeira dobra. */
  .topo-home__capa > :global(.mosaico) {
    width: min(100%, 26rem, 36svh);
  }

  .topo-home__subtitulo {
    margin-inline: auto;
  }

  @media (min-width: 40rem) and (orientation: portrait) {
    .topo-home__subtitulo {
      font-size: var(--texto-xl);
    }
  }

  @media (min-width: 40rem) and (orientation: landscape) {
    .topo-home__capa {
      justify-items: stretch;
      text-align: start;
    }

    .topo-home__subtitulo {
      margin-inline: 0;
    }

    .topo-home__capa {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: var(--espaco-6);
    }

    .topo-home__capa > :global(.mosaico) {
      width: clamp(11rem, 28vw, 20rem);
    }
  }

  .topo-home__nome {
    color: var(--cor-vinho);
    font-size: var(--texto-ronrom);
    line-height: var(--altura-linha-ronrom);
    letter-spacing: var(--espacamento-ronrom);
  }

  /* Assinatura discreta: pequena e no tom secundário, para não competir com o subtítulo. */
  .topo-home__autora {
    margin-block-start: var(--espaco-2);
    color: var(--cor-texto-2);
    font-size: var(--texto-sm);
  }

  .topo-home__subtitulo {
    max-width: 32ch;
    margin-block-start: var(--espaco-4);
    color: var(--cor-texto-2);
    font-size: var(--texto-lg);
  }

  /* 44×44 de área de toque, com a seta de 28px no meio. */
  .topo-home__rolar {
    display: grid;
    justify-self: center;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--raio-pilula);
    color: var(--cor-vinho);
  }

  .topo-home__rolar:hover {
    background-color: var(--cor-creme);
    color: var(--cor-vinho-hover);
  }

  .topo-home__rolar svg {
    width: 28px;
    height: 28px;
  }

  /* Só com movimento liberado: a seta balança de leve e a rolagem até o conteúdo é suave. */
  @media (prefers-reduced-motion: no-preference) {
    .topo-home__rolar svg {
      animation: balanco 2s ease-in-out infinite;
    }

    :global(html:has(.topo-home__rolar)) {
      scroll-behavior: smooth;
    }
  }

  /* Abertura (primeira visita da sessão; public/abertura-da-home.js): os quadrados do mosaico
     entram em diagonal a partir do gato, cada forma gira e se encaixa, o nome sobe sem começar
     invisível (é o LCP) e o texto aparece. No fim o gato ronrona, e só então a seta balança. Tudo
     com fill-mode backwards, para o hover do mosaico seguir funcionando depois. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not(.home-ja-vista)) .topo-home {
      --inicio: 0.1s;
      --passo: 0.07s;
    }

    :global(html:not(.home-ja-vista)) .topo-home__nome {
      animation: subir 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
    }

    :global(html:not(.home-ja-vista)) .topo-home__autora,
    :global(html:not(.home-ja-vista)) .topo-home__subtitulo {
      animation: aparecer 0.5s ease-out 0.25s backwards;
    }

    :global(html:not(.home-ja-vista)) .topo-home__subtitulo {
      animation-delay: 0.35s;
    }

    :global(html:not(.home-ja-vista)) .topo-home__capa :global(.mosaico__quadrado) {
      animation: quadrado-entra 0.45s cubic-bezier(0.2, 0.8, 0.2, 1)
        calc(var(--inicio) + var(--diagonal, 0) * var(--passo)) backwards;
    }

    :global(html:not(.home-ja-vista)) .topo-home__capa :global(.mosaico__forma) {
      animation: forma-encaixa 0.5s cubic-bezier(0.3, 1.4, 0.5, 1)
        calc(var(--inicio) + var(--diagonal, 0) * var(--passo) + 0.12s) backwards;
    }

    /* A diagonal de cada quadrado na grade 3×3 (linha + coluna), que define o atraso. */
    .topo-home__capa :global(.mosaico__quadrado:is(:nth-child(2), :nth-child(4))) {
      --diagonal: 1;
    }

    .topo-home__capa :global(.mosaico__quadrado:is(:nth-child(3), :nth-child(5), :nth-child(7))) {
      --diagonal: 2;
    }

    .topo-home__capa :global(.mosaico__quadrado:is(:nth-child(6), :nth-child(8))) {
      --diagonal: 3;
    }

    .topo-home__capa :global(.mosaico__quadrado:nth-child(9)) {
      --diagonal: 4;
    }

    /* O gato (o primeiro quadrado) ronrona quando o mosaico termina de montar. */
    :global(html:not(.home-ja-vista))
      .topo-home__capa
      :global(.mosaico__quadrado:first-child .mosaico__forma) {
      animation:
        forma-encaixa 0.5s cubic-bezier(0.3, 1.4, 0.5, 1) calc(var(--inicio) + 0.12s) backwards,
        ronronar 0.45s ease-in-out 1.05s;
    }

    :global(html:not(.home-ja-vista)) .topo-home__rolar svg {
      animation-delay: 1.5s;
    }

    :global(html:not(.home-ja-vista)) .topo-home__rolar {
      animation: aparecer 0.4s ease-out 1.3s backwards;
    }
  }

  @keyframes subir {
    from {
      transform: translateY(12px);
    }
  }

  @keyframes aparecer {
    from {
      opacity: 0;
    }
  }

  @keyframes quadrado-entra {
    from {
      opacity: 0;
      transform: scale(0.85);
    }
  }

  @keyframes forma-encaixa {
    from {
      opacity: 0;
      transform: rotate(-25deg) scale(0.6);
    }
  }

  @keyframes ronronar {
    0%,
    100% {
      transform: rotate(0);
    }

    20%,
    60% {
      transform: rotate(-5deg);
    }

    40%,
    80% {
      transform: rotate(5deg);
    }
  }

  @keyframes balanco {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(4px);
    }
  }
</style>
