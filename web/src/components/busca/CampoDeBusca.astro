---
// O campo de busca (#55): um formulário GET para a /busca, que funciona sem JS (o navegador abre
// /busca?q=termo). Na /busca, o script da página assume o envio e o slot recebe os filtros. O
// visual (#61): campo em pílula com a lupa, e o botão vinho ao lado.

interface Props {
  /** `id` do campo; o do rótulo e o do botão derivam dele. Único na página. */
  id?: string;
  /** Termo já preenchido. */
  valor?: string;
  /** Texto do rótulo. Fica só para o leitor de tela, a não ser com `rotuloVisivel`. */
  rotulo?: string;
  rotuloVisivel?: boolean;
  class?: string;
}

const {
  id = 'busca',
  valor,
  rotulo = 'Buscar no Ronrom',
  rotuloVisivel = false,
  class: classe,
} = Astro.props;
---

<form class:list={['campo-de-busca', classe]} role="search" action="/busca" method="get">
  <label class:list={['campo-de-busca__rotulo', { 'visualmente-oculto': !rotuloVisivel }]} for={id}>
    {rotulo}
  </label>
  <div class="campo-de-busca__linha">
    <span class="campo-de-busca__caixa">
      {/* Só decorativa: o rótulo e o botão já dizem que é uma busca. */}
      <svg
        class="campo-de-busca__lupa"
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <circle cx="10.5" cy="10.5" r="6.5"></circle>
        <path d="m15.5 15.5 5 5"></path>
      </svg>
      <input
        class="campo-de-busca__campo"
        id={id}
        type="search"
        name="q"
        value={valor}
        placeholder="Filmes, cafés, lugares…"
        autocomplete="off"
        enterkeyhint="search"
      />
    </span>
    <button class="campo-de-busca__botao" type="submit">
      Buscar
    </button>
  </div>
  <slot />
</form>

<style>
  .campo-de-busca {
    display: grid;
    gap: var(--espaco-2);
  }

  .campo-de-busca__rotulo {
    font-weight: var(--peso-medio);
  }

  .campo-de-busca__linha {
    display: flex;
    gap: var(--espaco-2);
  }

  .campo-de-busca__caixa {
    position: relative;
    display: flex;
    flex: 1;
    min-width: 0;
  }

  .campo-de-busca__lupa {
    position: absolute;
    inset-block: 0;
    inset-inline-start: var(--espaco-4);
    width: 1.125rem;
    height: 100%;
    color: var(--cor-texto-2);
    pointer-events: none;
  }

  /* 44px de altura nos dois, o alvo de toque mínimo. A borda (3:1 no fundo) fica vinho no hover e
     no foco, que também ganha o anel do :focus-visible. */
  /* width: 100% zera a largura mínima intrínseca do <input> (~20 caracteres): sem ela, o campo
     empurra a página para fora da tela em 320px. */
  .campo-de-busca__campo {
    flex: 1;
    width: 100%;
    min-width: 0;
    min-height: 44px;
    padding-inline: calc(var(--espaco-4) + 1.125rem + var(--espaco-2)) var(--espaco-4);
    border: 1px solid var(--cor-texto-2);
    border-radius: var(--raio-pilula);
    background-color: var(--cor-superficie);
    color: var(--cor-texto);
  }

  .campo-de-busca__campo:hover,
  .campo-de-busca__campo:focus {
    border-color: var(--cor-vinho);
  }

  .campo-de-busca__caixa:focus-within .campo-de-busca__lupa {
    color: var(--cor-vinho);
  }

  .campo-de-busca__campo::placeholder {
    color: var(--cor-texto-2);
  }

  .campo-de-busca__botao {
    min-height: 44px;
    padding-inline: var(--espaco-4);
    border: 2px solid var(--cor-vinho);
    border-radius: var(--raio-pilula);
    background-color: var(--cor-vinho);
    color: var(--cor-fundo);
    font-weight: var(--peso-medio);
    cursor: pointer;
  }

  .campo-de-busca__botao:hover {
    border-color: var(--cor-vinho-hover);
    background-color: var(--cor-vinho-hover);
  }
</style>
