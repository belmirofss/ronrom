---
import type { TypedObjectProps } from 'astro-portabletext/types';
import { videoDoLink } from '../../../../../studio/lib/video';
import EmbedInstagram from '@/components/post/EmbedInstagram.astro';
import VideoYoutube from '@/components/post/VideoYoutube.astro';
import type { Corpo } from '@/lib/corpo';

// Bloco "Vídeo": a fachada leve do YouTube ou o cartão do Instagram, que só carregam o player no
// clique. O provedor e o ID saem do link pela mesma função que valida o link no Studio, e não do
// `provedor` e do `idVideo` gravados: assim um ID mudado fora do Studio não chega ao iframe. Link
// que não é de vídeo (só possível fora do Studio) não aparece.
type Props = TypedObjectProps;

const { url, legenda } = Astro.props.node as Extract<Corpo[number], { _type: 'video' }>;

const video = videoDoLink(url);
const texto = legenda?.trim() || undefined;
---

{video?.provedor === 'youtube' && (
  <VideoYoutube idVideo={video.idVideo} titulo={texto} legenda={texto} />
)}
{video?.provedor === 'instagram' && <EmbedInstagram codigo={video.idVideo} legenda={texto} />}
