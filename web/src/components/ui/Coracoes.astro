---
import { coracoesDaNota, rotuloDaNota } from '@/lib/nota';

interface Props {
  /** De 0.5 a 5, em passos de 0.5. Nota ausente ou fora disso derruba o build. */
  nota: number | null | undefined;
  /** Altura de cada coração. Padrão: "medio". */
  tamanho?: 'pequeno' | 'medio' | 'grande';
  class?: string;
}

const { nota, tamanho = 'medio', class: classe } = Astro.props;

// Coração simétrico em x = 12 (o mesmo do input de nota do Studio): o meio coração é o desenho
// cheio dentro de um <svg> de 12 de largura, que recorta a metade direita sem precisar de id.
const CAMINHO =
  'M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z';
---

{/* Um nome só para a nota inteira: o leitor de tela anuncia o aria-label uma vez e ignora os SVGs. */}
<span
  class:list={['coracoes', `coracoes--${tamanho}`, classe]}
  role="img"
  aria-label={rotuloDaNota(nota)}
>
  {coracoesDaNota(nota).map((preenchimento) => (
    <svg
      class="coracoes__coracao"
      data-preenchimento={preenchimento}
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
    >
      <path d={CAMINHO} class="coracoes__contorno" />
      {preenchimento === 'cheio' && <path d={CAMINHO} class="coracoes__recheio" />}
      {preenchimento === 'meio' && (
        <svg width="12" height="24" viewBox="0 0 12 24">
          <path d={CAMINHO} class="coracoes__recheio" />
        </svg>
      )}
    </svg>
  ))}
</span>

<script>
  // Os corações reagem ao aparecer: fora da tela na chegada, esvaziam e enchem um a um quando
  // entram nela; já visíveis na chegada, só dão um pulinho (esvaziar ali piscaria). Sem JS ou com
  // movimento reduzido, ficam como no HTML.
  const reduzido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const notas = document.querySelectorAll<HTMLElement>('.coracoes');
  if (!reduzido && notas.length > 0 && 'IntersectionObserver' in window) {
    const observador = new IntersectionObserver(
      (entradas) => {
        for (const { isIntersecting, target } of entradas) {
          if (!isIntersecting) continue;
          target.classList.replace('coracoes--vazios', 'coracoes--enchendo');
          observador.unobserve(target);
        }
      },
      { threshold: 1, rootMargin: '0px 0px -10% 0px' },
    );
    for (const nota of notas) {
      const { top, bottom } = nota.getBoundingClientRect();
      if (bottom > 0 && top < window.innerHeight) {
        nota.classList.add('coracoes--pulando');
      } else {
        nota.classList.add('coracoes--vazios');
        observador.observe(nota);
      }
    }
  }
</script>

<style>
  .coracoes {
    display: inline-flex;
    gap: 0.125em;
    vertical-align: middle;
    color: var(--cor-vinho);
  }

  .coracoes--pequeno {
    font-size: 1rem;
  }

  .coracoes--medio {
    font-size: 1.25rem;
  }

  .coracoes--grande {
    font-size: 1.75rem;
  }

  .coracoes__coracao {
    flex: none;
    width: 1em;
    height: 1em;
  }

  /* Vinho também no contorno do coração vazio (9,70:1 no fundo): a nota é legível só pelo
     desenho, sem depender de diferenciar tons. */
  .coracoes__contorno {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .coracoes__recheio {
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  /* As classes abaixo vêm do script. O recheio cresce do centro do próprio coração. */
  .coracoes__recheio {
    transform-box: fill-box;
    transform-origin: center;
  }

  .coracoes--vazios .coracoes__recheio {
    transform: scale(0);
  }

  .coracoes--enchendo .coracoes__recheio {
    animation: encher 0.45s cubic-bezier(0.3, 1.6, 0.5, 1) backwards;
  }

  .coracoes--pulando .coracoes__coracao {
    animation: pular 0.5s ease-out backwards;
  }

  /* Um depois do outro, da esquerda para a direita. */
  .coracoes__coracao:nth-child(2),
  .coracoes__coracao:nth-child(2) .coracoes__recheio {
    animation-delay: 0.09s;
  }

  .coracoes__coracao:nth-child(3),
  .coracoes__coracao:nth-child(3) .coracoes__recheio {
    animation-delay: 0.18s;
  }

  .coracoes__coracao:nth-child(4),
  .coracoes__coracao:nth-child(4) .coracoes__recheio {
    animation-delay: 0.27s;
  }

  .coracoes__coracao:nth-child(5),
  .coracoes__coracao:nth-child(5) .coracoes__recheio {
    animation-delay: 0.36s;
  }

  @keyframes encher {
    from {
      transform: scale(0);
    }
  }

  @keyframes pular {
    40% {
      transform: scale(1.25);
    }
  }
</style>
