---
// Vitrine dos componentes de interface: todos os estados numa página só, para revisar o visual e
// testar com teclado e leitor de tela. Fica fora de src/pages porque só existe no `astro dev`: a
// integração do astro.config.mjs injeta a rota /vitrine no dev, e o build nem a conhece.
import BarraLateral from '@/components/barra-lateral/BarraLateral.astro';
import FraseDaSemana from '@/components/barra-lateral/FraseDaSemana.astro';
import Container from '@/components/layout/Container.astro';
import CardDePost from '@/components/post/CardDePost.astro';
import Destaque from '@/components/post/Destaque.astro';
import ItemDeLista from '@/components/post/ItemDeLista.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import ChipCategoria from '@/components/ui/ChipCategoria.astro';
import Coracoes from '@/components/ui/Coracoes.astro';
import EstadoVazio from '@/components/ui/EstadoVazio.astro';
import Paginacao from '@/components/ui/Paginacao.astro';
import LayoutBase from '@/layouts/LayoutBase.astro';
import { NOTA_MAXIMA, NOTA_MINIMA } from '@/lib/nota';
import { buscarDestaque, buscarLeiaTambem, buscarUltimos } from '@/lib/sanity/conteudo';
import { urlDaCategoria, urlDaTag, urlDoFormato } from '@/lib/rotas';
import { trilhaDaCategoria, trilhaDoFormato, trilhaDoPost } from '@/lib/trilha';

const NOTAS = Array.from(
  { length: (NOTA_MAXIMA - NOTA_MINIMA) / NOTA_MINIMA + 1 },
  (_, i) => NOTA_MINIMA * (i + 1),
);

const FILMES = { nome: 'Filmes', slug: 'filmes' };
const FRASES = { nome: 'Frases soltas', slug: 'frases' };

const PAGINAS: { titulo: string; atual: number; total: number }[] = [
  { titulo: 'Primeira de 10', atual: 1, total: 10 },
  { titulo: 'Segunda de 10', atual: 2, total: 10 },
  { titulo: 'Meio (5 de 10)', atual: 5, total: 10 },
  { titulo: 'Penúltima de 10', atual: 9, total: 10 },
  { titulo: 'Última de 10', atual: 10, total: 10 },
  { titulo: 'Meio de 50 (25)', atual: 25, total: 50 },
  { titulo: 'Poucas páginas (2 de 3)', atual: 2, total: 3 },
  { titulo: 'Sete páginas, sem reticências (4 de 7)', atual: 4, total: 7 },
];

const FRASES_DA_SEMANA: { titulo: string; frase: { texto?: string; autoria?: string } }[] = [
  {
    titulo: 'Com autoria',
    frase: { texto: 'Devagar também é um jeito de chegar.', autoria: 'Ditado de avó' },
  },
  { titulo: 'Sem autoria', frase: { texto: 'Café passado na hora resolve quase tudo.' } },
  {
    titulo: 'No limite de 280 caracteres',
    frase: {
      texto:
        'Tem semana que a gente só quer um filme bom, um livro que não acabe e um café que não esfrie antes do último gole. Nesta, eu quis as três coisas e ainda um pouco de silêncio, daquele que só existe às seis da manhã, antes de o prédio acordar e o gato pedir comida pela terceira vez.',
      autoria: 'Caderno, página 42',
    },
  },
];

// Os cards saem do Sanity (ou das fixtures). Os casos que o conteúdo pode não ter, como título
// longo, categoria longa e pensamento sem subtítulo, são montados por cima de um post de verdade.
const destaque = await buscarDestaque();
const { posts } = await buscarUltimos();
const leiaTambem = destaque ? await buscarLeiaTambem(destaque._id) : [];

const review = posts.find((post) => post.tipo === 'review');
const pensamento = posts.find((post) => post.tipo === 'pensamento');
const TITULO_LONGO =
  'Um título bem comprido, de três linhas ou mais no celular, para ver se o card aguenta sem cortar nada';
const casosExtremos = [
  review && {
    ...review,
    titulo: TITULO_LONGO,
    categoria: { nome: 'Restaurantes e cafés', slug: 'restaurantes-e-cafes' },
  },
  pensamento && { ...pensamento, subtitulo: null },
].filter((post) => post !== undefined);
---

<LayoutBase
  seo={{
    title: 'Vitrine de componentes',
    description:
      'Todos os estados dos componentes de interface, só no ambiente de desenvolvimento.',
    canonical: '/vitrine',
    noindex: true,
  }}
>
  <Container>
    <div class="vitrine">
      <h1>Vitrine de componentes</h1>
      <p class="vitrine__nota">
        Só no <code>astro dev</code>: esta página não entra no build.
      </p>

      <section aria-labelledby="titulo-coracoes">
        <h2 id="titulo-coracoes">Coracoes</h2>
        <h3>Todas as notas (médio)</h3>
        <dl class="vitrine__grade">
          {NOTAS.map((nota) => (
            <div>
              <dt>{nota}</dt>
              <dd>
                <Coracoes nota={nota} />
              </dd>
            </div>
          ))}
        </dl>
        <h3>Tamanhos (nota 3,5)</h3>
        <dl class="vitrine__grade">
          {(['pequeno', 'medio', 'grande'] as const).map((tamanho) => (
            <div>
              <dt>{tamanho}</dt>
              <dd>
                <Coracoes nota={3.5} tamanho={tamanho} />
              </dd>
            </div>
          ))}
        </dl>
        <h3>No meio do texto</h3>
        <p>
          Assisti numa tarde de domingo e dei <Coracoes nota={4.5} tamanho="pequeno" /> sem pensar.
        </p>
      </section>

      <section aria-labelledby="titulo-chips">
        <h2 id="titulo-chips">ChipCategoria</h2>
        <h3>Link</h3>
        <p class="vitrine__linha">
          <ChipCategoria nome="Filmes" href={urlDaCategoria('filmes')} />
          <ChipCategoria
            nome="Restaurantes e cafés"
            href={urlDaCategoria('restaurantes-e-cafes')}
          />
          <ChipCategoria nome="Frases soltas" href={urlDoFormato('frases')} tom="rosa" />
          <ChipCategoria nome="#café" href={urlDaTag('cafe')} tom="rosa" />
        </p>
        <h3>Estático</h3>
        <p class="vitrine__linha">
          <ChipCategoria nome="Livros" />
          <ChipCategoria nome="Opiniões" tom="rosa" />
        </p>
        <h3>Sobre a miniatura (card inteiro é o link)</h3>
        <div class="vitrine__linha">
          {(['creme', 'rosa'] as const).map((tom) => (
            <a class="vitrine__card" href={urlDaCategoria('filmes')}>
              <span class="vitrine__miniatura" data-tom={tom}>
                <ChipCategoria class="vitrine__chip-sobreposto" nome="Filmes" tom={tom} />
              </span>
              <span>Dias Perfeitos</span>
            </a>
          ))}
        </div>
      </section>

      <section aria-labelledby="titulo-trilha">
        <h2 id="titulo-trilha">Breadcrumb</h2>
        <h3>Review</h3>
        <Breadcrumb
          itens={trilhaDoPost({
            tipo: 'review',
            titulo: 'Dias Perfeitos',
            slug: 'dias-perfeitos',
            categoria: FILMES,
          })}
        />
        <h3>Pensamento com título longo</h3>
        <Breadcrumb
          itens={trilhaDoPost({
            tipo: 'pensamento',
            titulo:
              'Uma frase bem comprida para ver como a trilha quebra a linha no celular sem estourar a largura',
            slug: 'frase-comprida',
            formato: FRASES,
          })}
        />
        <h3>Categoria</h3>
        <Breadcrumb itens={trilhaDaCategoria(FILMES)} />
        <h3>Formato</h3>
        <Breadcrumb itens={trilhaDoFormato(FRASES)} />
      </section>

      <section aria-labelledby="titulo-paginacao">
        <h2 id="titulo-paginacao">Paginacao</h2>
        {PAGINAS.map(({ titulo, atual, total }) => (
          <>
            <h3>{titulo}</h3>
            <Paginacao base={urlDaCategoria('filmes')} atual={atual} total={total} />
          </>
        ))}
        <h3>Uma página só</h3>
        <p class="vitrine__nota">Não renderiza nada:</p>
        <Paginacao base={urlDaCategoria('filmes')} atual={1} total={1} />
      </section>

      {/* Os cards ficam abaixo do h2 da seção, como o "Leia também": título em h3. */}
      <section aria-labelledby="titulo-destaque">
        <h2 id="titulo-destaque">Destaque</h2>
        {destaque ? (
          <Destaque post={destaque} nivelTitulo={3} />
        ) : (
          <p class="vitrine__nota">Nenhum post publicado.</p>
        )}
        {casosExtremos.map((post) => (
          <>
            <h3>
              {post.tipo === 'review' ? 'Título e categoria longos' : 'Pensamento sem subtítulo'}
            </h3>
            <Destaque post={post} nivelTitulo={4} />
          </>
        ))}
      </section>

      <section aria-labelledby="titulo-item-de-lista">
        <h2 id="titulo-item-de-lista">ItemDeLista</h2>
        <h3>Todos os posts (página 1)</h3>
        <ul class="vitrine__lista">
          {posts.map((post) => (
            <li>
              <ItemDeLista post={post} nivelTitulo={4} />
            </li>
          ))}
        </ul>
        <h3>Casos extremos, na largura do celular de 320px</h3>
        <ul class="vitrine__lista vitrine__lista--estreita">
          {casosExtremos.map((post) => (
            <li>
              <ItemDeLista post={post} nivelTitulo={4} />
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="titulo-card-de-post">
        <h2 id="titulo-card-de-post">CardDePost</h2>
        <h3>Leia também</h3>
        <ul class="vitrine__cards">
          {leiaTambem.map((post) => (
            <li>
              <CardDePost post={post} nivelTitulo={4} />
            </li>
          ))}
        </ul>
        <h3>Casos extremos, na largura do celular de 320px</h3>
        <ul class="vitrine__cards vitrine__lista--estreita">
          {casosExtremos.map((post) => (
            <li>
              <CardDePost post={post} nivelTitulo={4} />
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="titulo-estado-vazio">
        <h2 id="titulo-estado-vazio">EstadoVazio</h2>
        <h3>Padrão</h3>
        <EstadoVazio />
        <h3>Com mensagem e link próprios</h3>
        <EstadoVazio
          mensagem="Nenhuma review de livros por enquanto."
          link={{ rotulo: 'Ver todas as reviews', href: '/reviews' }}
        />
      </section>

      <section aria-labelledby="titulo-frase">
        <h2 id="titulo-frase">FraseDaSemana</h2>
        <div class="vitrine__grade vitrine__grade--larga">
          {FRASES_DA_SEMANA.map(({ titulo, frase }) => (
            <div>
              <h3>{titulo}</h3>
              <FraseDaSemana frase={frase} />
            </div>
          ))}
        </div>
        <h3>Sem frase cadastrada</h3>
        <p class="vitrine__nota">Não renderiza nada:</p>
        <FraseDaSemana frase={{ texto: '   ', autoria: 'Ditado de avó' }} />
      </section>

      {/* Os títulos da barra lateral são h2: aqui ficam abaixo do h2 da seção, como na página. */}
      <section aria-labelledby="titulo-barra-lateral">
        <h2 id="titulo-barra-lateral">BarraLateral</h2>
        <p class="vitrine__nota">
          Com o conteúdo do Sanity (ou das fixtures), na largura da coluna lateral (20rem).
        </p>
        <div class="vitrine__barra-lateral">
          <BarraLateral />
        </div>
      </section>
    </div>
  </Container>
</LayoutBase>

<style>
  .vitrine section {
    margin-block-start: var(--espaco-7);
  }

  .vitrine {
    padding-block: var(--espaco-7);
  }

  .vitrine h1 {
    font-size: var(--texto-3xl);
  }

  .vitrine h2 {
    padding-block-end: var(--espaco-2);
    border-block-end: 1px solid var(--cor-borda);
    font-size: var(--texto-2xl);
  }

  .vitrine h3 {
    margin-block: var(--espaco-5) var(--espaco-3);
    color: var(--cor-texto-2);
    font-size: var(--texto-sm);
    font-weight: var(--peso-medio);
    letter-spacing: 0;
  }

  .vitrine__nota {
    color: var(--cor-texto-2);
    font-size: var(--texto-sm);
  }

  .vitrine__grade {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: var(--espaco-4);
  }

  .vitrine__grade--larga {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    align-items: start;
  }

  .vitrine__barra-lateral {
    max-width: 20rem;
    margin-block-start: var(--espaco-5);
  }

  .vitrine__grade dt {
    color: var(--cor-texto-2);
    font-size: var(--texto-xs);
  }

  .vitrine__linha {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--espaco-3);
  }

  .vitrine__lista,
  .vitrine__cards {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vitrine__lista {
    display: grid;
    gap: var(--espaco-6);
  }

  .vitrine__cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--espaco-5);
  }

  /* 320px menos o gutter de 16px de cada lado. */
  .vitrine__lista--estreita {
    max-width: 288px;
  }

  .vitrine__card {
    display: grid;
    gap: var(--espaco-2);
    width: 12rem;
    color: var(--cor-texto);
    font-weight: var(--peso-medio);
  }

  .vitrine__miniatura {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--raio-md);
    background-color: var(--cor-vinho);
  }

  .vitrine__miniatura[data-tom='creme'] {
    background-color: var(--cor-malva);
  }

  .vitrine :global(.vitrine__chip-sobreposto) {
    position: absolute;
    inset-block-start: var(--espaco-2);
    inset-inline-start: var(--espaco-2);
  }
</style>
