# Copie para studio/.env e preencha. O .env não é versionado.
# Os dois valores ficam em https://www.sanity.io/manage, no projeto "Ronrom".

# ID do projeto (aparece no topo da página do projeto). Não é segredo, mas fica fora do código.
SANITY_STUDIO_PROJECT_ID=

# Dataset que o Studio edita: development no dia a dia, production para conteúdo real.
# O build e o deploy usam sempre production (studio/.env.production).
SANITY_STUDIO_DATASET=development

# Endereço da prévia de rascunhos que a aba Apresentação abre (#43). Padrão:
# https://ronrom-previa.vercel.app. Para usar o site local com a prévia ligada:
# SANITY_STUDIO_PREVIEW_URL=http://localhost:4321
SANITY_STUDIO_PREVIEW_URL=

# Tokens NÃO entram neste arquivo nem em nenhum outro versionado. Ficam nos Secrets do GitHub
# e nas variáveis de ambiente da Vercel (veja studio/README.md):
#   SANITY_API_READ_TOKEN   token "viewer" (Viewer): prévia de rascunhos e backup
#   SANITY_AUTH_TOKEN       token "studio-deploy-ci-5" (Deploy Studio): sanity deploy no CI
